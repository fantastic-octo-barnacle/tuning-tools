{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "studio-server",
      "type": "shell",
      "command": "cargo build -p studio-server",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "webview",
      "type": "shell",
      "command": "npm run build:webview",
